{
  "name": "margrete-rpc-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "build:docs": "bun scripts/python-generate.mjs && bun scripts/generate-docs.mjs",
    "dev": "next dev",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "postinstall": "fumadocs-mdx",
    "lint": "oxlint",
    "start": "next start",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fuma-translate/react": "^1.0.2",
    "@fumadocs/base-ui": "^16.17.10",
    "class-variance-authority": "^0.7.1",
    "fumadocs-core": "16.17.10",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-python": "^1.0.5",
    "fumadocs-ui": "16.17.10",
    "lucide-react": "^1.66.0",
    "next": "16.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.3",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-packagejson": "^3.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-medium-image-zoom": "^5.4.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
