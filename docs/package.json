{
  "name": "margrete-rpc-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "build:docs": "bun scripts/python-generate.mjs && bun scripts/generate-docs.mjs",
    "dev": "next dev",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "postinstall": "fumadocs-mdx",
    "lint": "oxlint",
    "start": "next start",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fuma-translate/react": "^1.0.2",
    "@fumadocs/base-ui": "^16.10.3",
    "class-variance-authority": "^0.7.1",
    "fumadocs-core": "16.10.3",
    "fumadocs-mdx": "15.0.12",
    "fumadocs-python": "^0.0.11",
    "fumadocs-ui": "16.10.3",
    "lucide-react": "^1.18.0",
    "next": "16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rimraf": "^6.1.3",
    "shiki": "^4.2.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/mdx": "^2.0.14",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "oxlint": "^1.70.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react-medium-image-zoom": "^5.4.7",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3"
  }
