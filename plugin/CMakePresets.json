{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-vcpkg-base",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (vcpkg static-md)",
      "inherits": "windows-vcpkg-base",
      "binaryDir": "${sourceDir}/build",
      "architecture": "x64",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
      }
    },
    {
      "name": "windows-x64-cicd",
      "displayName": "Windows x64 Release (vcpkg static-md)",
      "inherits": "windows-x64",
      "cacheVariables": {
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/vcpkg-triplets",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md-release",
        "VCPKG_HOST_TRIPLET": "x64-windows-release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64",
      "configuration": "Release"
    },
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64",
      "configuration": "Debug"
    },
    {
      "name": "windows-x64-release-cicd",
      "configurePreset": "windows-x64-cicd",
      "configuration": "Release"
    }
  ]
}
